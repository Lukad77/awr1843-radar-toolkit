26-07-14T17:07:00.117167+08:00","gmt_modified":"2026-07-14T17:08:46.613352+08:00","raw_data":"WikiEncrypted:"},{"id":"b26b1213-361b-4904-9c01-e8057347be3b","repo_id":"580a5bde-1269-4820-a326-735108b48546","name":"数据接收与帧重组","description":"数据接收与帧重组","prompt":"第 1 层（数据接收层）：讲解 UDPReceiver 经数据口 4098 接收 DCA1000 的 LVDS 数据流(三种接收模式、包结构 seqNum+byteCnt+payload)、UnlockQueue 无锁环形队列缓冲，以及基于 seqNum 的跨帧重组算法(SortPackets)；以 net_compat.h 跨平台 socket 层为基础。此为纯数据通路，不含设备控制命令。","parent_id":"f1ae0c68-7a13-46b2-884a-cb16b42cd69a","progress_status":"completed","gmt_create":"2026-07-14T17:07:00.118854+08:00","gmt_modified":"2026-07-14T17:11:03.732042+08:00","raw_data":"WikiEncrypted:","layer_level":1},{"id":"0e4ca3ea-cace-4a0f-90f0-879f76558c0a","repo_id":"580a5bde-1269-4820-a326-735108b48546","name":"DCA1000 命令控制","description":"DCA1000 命令控制","prompt":"描述 UDPController 通过命令口 4096 向 DCA1000 发送控制命令的协议(5aa5 header + cmd + length + body + aaee footer)、CommandCode 命令集(复位/配置/启停录制等)与收发/超时处理，底层依赖 net_compat.h 跨平台 socket。","parent_id":"56141336-51e2-47fa-95ab-49096e3dfe0c","progress_status":"completed","gmt_create":"2026-07-14T17:07:00.119517+08:00","gmt_modified":"2026-07-14T17:11:42.968103+08:00","raw_data":"WikiEncrypted:","layer_level":1},{"id":"c3a8348d-fd08-482a-9530-d1922c222eba","repo_id":"580a5bde-1269-4820-a326-735108b48546","name":"构建系统与运行入口","description":"构建系统与运行入口","prompt":"解析 CMakeLists.txt 的跨平台配置、test_udp 与 radar_full 两个构建目标的源文件组成与用途，以及主程序 #if 0(实时采集)/#if 1(离线解析) 两种运行模式。","order":1,"progress_status":"completed","gmt_create":"2026-07-14T17:07:00.118249+08:00","gmt_modified":"2026-07-14T17:07:38.724517+08:00","raw_data":"WikiEncrypted:"},{"id":"3544a62f-4ae0-42ef-911b-8e45d11b7efc","repo_id":"580a5bde-1269-4820-a326-735108b48546","name":"雷达数据解析","description":"雷达数据解析","prompt":"第 2 层（解析层）：说明 DataParser 如何把数据接收层交付的原始 ADC 字节流解析为复数 I/Q，含单天线(parse_FrameData)与全天线(parse_FrameData_AllRX)两种输出、I/Q 交织格式(每 2 sample 占 4 int16)与 RadarParams 参数、expectSize_ 校验。","parent_id":"f1ae0c68-7a13-46b2-884a-cb16b42cd69a","order":1,"progress_status":"completed","gmt_create":"2026-07-14T17:07:00.118996+08:00","gmt_modified":"2026-07-14T17:11:59.889931+08:00","raw_data":"WikiEncrypted:","layer_level":1},{"id":"47031f97-cb6a-4b50-9817-9b88bcd97837","repo_id":"580a5bde-1269-4820-a326-735108b48546","name":"串口通信与 AWR1843 雷达控制","description":"串口通信与 AWR1843 雷达控制","prompt":"梳理串口栈：SerialPort 抽象基类 → WzSerialPortAdapter 适配器 → WzSerialportPlus 底层驱动；以及 AWR1843Controller 的双串口设计(CLI/数据)、cfg 配置下发、参数计算与 TLV 帧(parseData18xx)解析。","parent_id":"56141336-51e2-47fa-95ab-49096e3dfe0c","order":1,"progress_status":"completed","gmt_create":"2026-07-14T17:07:00.119695+08:00","gmt_modified":"2026-07-14T17:12:30.687538+08:00","raw_data":"WikiEncrypted:","layer_level":1},{"id":"f1ae0c68-7a13-46b2-884a-cb16b42cd69a","repo_id":"580a5bde-1269-4820-a326-735108b48546","name":"网络数据链路与解析","description":"网络数据链路与解析","prompt":"统领从数据接收到解析的两层结构：下层数据接收与帧重组负责跨平台 socket 收取 LVDS 数据流并按 seqNum 还原成帧，上层雷达数据解析把原始字节还原为复数 I/Q。给出两层的职责边界与自下而上的数据流协作关系。本链路只含数据通路，DCA1000 命令控制归入设备控制章节。","order":2,"progress_status":"completed","gmt_create":"2026-07-14T17:07:00.118691+08:00","gmt_modified":"2026-07-14T17:08:16.704483+08:00","raw_data":"WikiEncrypted:"},{"id":"56141336-51e2-47fa-95ab-49096e3dfe0c","repo_id":"580a5bde-1269-4820-a326-735108b48546","name":"雷达与 DCA1000 设备控制","description":"雷达与 DCA1000 设备控制","prompt":"设备控制章节总览：把针对 DCA1000 的 UDP 命令控制与针对 AWR1843 的串口控制归为同一'配置/启停设备'语义域，说明两条控制通道(命令口4096 / 串口)的职责、共性与区别，并与数据接收通路(数据口4098)明确区分。","order":3,"progress_status":"completed","gmt_create":"2026-07-14T17:07:00.119367+08:00","gmt_modified":"2026-07-14T17:08:47.345734+08:00","raw_data":"WikiEncrypted:"},{"id":"68b16f8b-585c-4c4b-9876-458de49f3083","repo_id":"580a5bde-1269-4820-a326-735108b48546","name":"跨平台兼容性设计","description":"跨平台兼容性设计","prompt":"解释 net_compat.h 如何将 winsock2 与 BSD socket 差异收口(SOCKET 类型统一、net_* 辅助函数)，以及串口层 Win32(DCB/ReadFile) 与 POSIX(termios/read) 的双实现与 SO_RCVTIMEO 差异处理。","order":4,"progress_status":"completed","gmt_create":"2026-07-14T17:07:00.119974+08:00","gmt_modified":"2026-07-14T17:09:40.678107+08:00","raw_data":"WikiEncrypted:"},{"id":"b6b295fb-73bd-40d7-acbf-f2ae4532ffa8","repo_id":"580a5bde-1269-4820-a326-735108b48546","name":"日志系统","description":"日志系统","prompt":"分析 Logger.h 的多线程安全日志：单例 Logger、观察者模式的 LogSink(ConsoleSink/FileSink)、LogQueue 生产者-消费者异步写出，以及 {} 占位符变参模板格式化与日志级别。","order":5,"progress_status":"completed","gmt_create":"2026-07-14T17:07:00.120129+08:00","gmt_modified":"2026-07-14T17:09:48.560033+08:00","raw_data":"WikiEncrypted:"},{"id":"75a37c8b-863d-4703-8e52-8421c183bc7b","repo_id":"580a5bde-1269-4820-a326-735108b48546","name":"实时处理流水线与数据流","description":"实时处理流水线与数据流","prompt":"描述 RealTimeDataProcessor 如何串联 UDPReceiver 与 DataParser，批量(FRAME_BATCH_SIZE)累积后落盘(解析后复数 / 原始 ADC 两种写盘模式)，并给出实时采集端到端数据流时序。","order":6,"progress_status":"completed","gmt_create":"2026-07-14T17:07:00.120198+08:00","gmt_modified":"2026-07-14T17:09:53.07008+08:00","raw_data":"WikiEncrypted:"},{"id":"3519f47a-2710-44d8-84c4-d30e779aca30","repo_id":"580a5bde-1269-4820-a326-735108b48546","name":"数据处理流程扩展开发指南","description":"数据处理流程扩展开发指南","prompt":"面向二次开发：说明后续新增的数据处理流程(如 Range-FFT/Doppler-FFT/CFAR/点云检测)如何接入现有流水线。明确规范接入点：实时链路在 RealTimeDataProcessor::ProcessingLoop 中 parse_FrameData 成功产出复数帧之后插入新处理级，离线链路在 main(#if 1) 的 parse 之后；级间数据契约统一用 DataParser 输出类型 FrameDataSingleRx/FrameDataAllRx；并给出配置(RadarParams)、批量落盘(WriteParsedFramesToFile 模式)、日志(Logger)、线程与锁(bufferMutex/fileMutex)等配套约定，以及新增一个算法级的步骤与注意事项。","order":7,"progress_status":"completed","gmt_create":"2026-07-14T17:07:00.120372+08:00","gmt_modified":"2026-07-14T17:11:08.651653+08:00","raw_data":"WikiEncrypted:"},{"id":"ba310f3a-5401-4700-ba96-b04ea6afd23a","repo_id":"580a5bde-1269-4820-a326-735108b48546","name":"雷达与采集参数配置文件","description":"雷达与采集参数配置文件","prompt":"讲解 1T1R.cfg / awr1843.cfg 的 mmWave CLI 命令(dfeDataOutputMode/channelCfg/profileCfg/chirpCfg/frameCfg/sensorStart 等)含义与关键字段，说明 AWR1843Controller 如何读取下发并由 profileCfg/frameCfg/channelCfg 推导距离分辨率、多普勒分辨率、最大距离/速度等雷达参数；并解释 cf.json 中 DCA1000 的 LVDS/以太网流/dataFormatMode/packetDelay 等采集配置。","order":8,"progress_status":"completed","gmt_create":"2026-07-14T17:07:00.120528+08:00","gmt_modified":"2026-07-14T17:10:40.910784+08:00","raw_data":"WikiEncrypted:"}],"wiki_items":[{"catalog_id":"c3a8348d-fd08-482a-9530-d1922c222eba","title":"构建系统与运行入口","description":"构建系统与运行入口","extend":"{}","progress_status":"completed","repo_id":"580a5bde-1269-4820-a326-735108b48546","reference_count":0,"id":"8d058009-f3b6-4956-80b3-35c94f03604c","gmt_create":"2026-07-14T17:07:38.717379+08:00","gmt_modified":"2026-07-14T17:07:38.724862+08:00"},{"catalog_id":"f1ae0c68-7a13-46b2-884a-cb16b42cd69a","title":"网络数据链路与解析","description":"网络数据链路与解析","extend":"{}","progress_status":"completed","repo_id":"580a5bde-1269-4820-a326-735108b48546","reference_count":0,"id":"6466b4b9-4d13-4d57-a596-5d8a6b21e10d","gmt_create":"2026-07-14T17:08:16.695921+08:00","gmt_modified":"2026-07-14T17:08:16.704971+08:00"},{"catalog_id":"5479da9a-0c47-4082-afaf-8caf9aecab5a","title":"项目概述与整体架构","description":"项目概述与整体架构","extend":"{}","progress_status":"completed","repo_id":"580a5bde-1269-4820-a326-735108b48546","reference_count":0,"id":"2595f6ae-a821-416e-827e-e7fdb5577b02","gmt_create":"2026-07-14T17:08:46.609694+08:00","gmt_modified":"2026-07-14T17:08:46.613448+08:00"},{"catalog_id":"56141336-51e2-47fa-95ab-49096e3dfe0c","title":"雷达与 DCA1000 设备控制","description":"雷达与 DCA1000 设备控制","extend":"{}","progress_status":"completed","repo_id":"580a5bde-1269-4820-a326-735108b48546","reference_count":0,"id":"41ec658f-2772-4fad-a4c2-c5993b6992d9","gmt_create":"2026-07-14T17:08:47.341951+08:00","gmt_modified":"2026-07-14T17:08:47.345839+08:00"},{"catalog_id":"68b16f8b-585c-4c4b-9876-458de49f3083","title":"跨平台兼容性设计","description":"跨平台兼容性设计","extend":"{}","progress_status":"completed","repo_id":"580a5bde-1269-4820-a326-735108b48546","reference_count":0,"id":"660afadc-1bd2-44a8-b25f-44e6c7fff706","gmt_create":"2026-07-14T17:09:40.675681+08:00","